    "test:eighth": "node scripts/test-eighth-order-promotions.mjs",
    "test:convergence": "node scripts/test-post-refactor-222.mjs",
    "test:224": "node scripts/test-post-refactor-224.mjs",
    "test:225": "node scripts/test-post-refactor-225.mjs",
    "test:226": "node scripts/test-post-refactor-226.mjs",
    "test:227": "node scripts/test-post-refactor-227.mjs",
    "test:228": "node scripts/test-post-refactor-228.mjs",
    "test:229": "node scripts/test-post-refactor-229.mjs",
